{
  "name": "gated-support-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker run -d --name gsa-pg -e POSTGRES_PASSWORD=postgres -p 55441:5432 postgres:17",
    "db:down": "docker rm -f gsa-pg",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "record": "node --env-file-if-exists=.env.local scripts/record.ts",
    "dev": "next dev -p 3101",
    "build": "next build",
    "start": "next start -p 3101",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "^6.0.3"
  }
}
